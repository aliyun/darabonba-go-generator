model M {
  config?: string
}

// Quote and backslash escape cases for Go string literals.
static async function main(args: [ string ]) throws : void {
  var s = "a\"b";
  var t = "{\"enableHistoryServer\":false}";
  var u = "a\\b";
  var v = "a\\\"b";
}

static function build(): M {
  var m = new M{
    config = "{\"enableHistoryServer\":false,\"disableHistoryServerAuth\":false,\"useVPCEndpoint\":false}"
  };
  return m;
}
